    "keepRecent": 20,
    "foldRecentContext": 6,
    "resultChars": 300,
    "foldToolMessages": true,
    "foldingReasoningTurns": 0,
    "preferSubagent": true,
    "subagentPreference": "",
    "debugStats": false,
    "concurrency": {
      "_说明": "单并发模型闸门：用户聊天时让定时任务和群聊让路；只对本地单并发模型有意义。",
      "enabled": false,
      "deferMinutes": 30,
      "userActiveSeconds": 90,
      "groupPause": true,
      "groupMaxAgeMinutes": 10,
      "leaseTtlMinutes": 10
    }
  },
  "bridge": {
    "_说明": "QQ / OneBot 桥接：开关、账号、WS 地址、媒体、私聊余波与群聊。",
    "enabled": false,
    "ownerQQ": 0,
    "ownerName": "",
    "wsUrl": "ws://127.0.0.1:3001",
    "token": "",
    "privateSessionTitle": "qq-chat",
    "location": "",
