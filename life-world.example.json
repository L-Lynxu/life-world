    "running": true,
    "reviewHour": 23,
    "fallbackWakeTime": "09:00",
    "resetHour": null,
    "recentLimit": 80,
    "summaryLimit": 12000,
    "alarmStaleHours": 6,
    "resetCooldownMinutes": 5,
    "homeTitle": "life-world home session",
